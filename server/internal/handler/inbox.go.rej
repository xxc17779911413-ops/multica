+			} else {
+				h.recordIssueWindow(item.policy.action, "inbox_summary", "would_block")
+			}
+		}
+		if count == 0 {
+			continue
 		}
+		resp = append(resp, InboxWorkspaceUnreadResponse{
+			WorkspaceID: uuidToString(row.WorkspaceID),
+			Count:       count,
+		})
 	}
 
